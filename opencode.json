{
  "$schema": "https://opencode.ai/config.json",
  "model": "glm/glm-5.3",
  "provider": {
    "glm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Self-hosted GLM 5.3",
      "options": {
        "baseURL": "{env:GLM_BASE_URL}",
        "apiKey": "{env:GLM_API_KEY}"
      },
      "models": {
        "glm-5.3": {
          "name": "GLM 5.3",
          "limit": {
            "context": 200000,
            "output": 32000
          }
        }
      }
    }
  },
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "ask",
      "*.env.*": "ask",
      "*.env.example": "allow"
    },
    "webfetch": "allow"
  }
}
